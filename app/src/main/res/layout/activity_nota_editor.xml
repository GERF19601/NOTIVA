<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Flecha para regresar -->
        <ImageButton
            android:id="@+id/btnVolverNota"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_volver"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="Volver a mis notas" />

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="✦ NOTIVA ✦"
            android:textColor="#7548C4"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTituloEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nueva nota"
            android:textColor="#39235E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dale un lugar especial a tus pensamientos."
            android:textColor="#655477"
            android:textSize="15sp" />

        <!-- Título de la nota -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Título"
            android:textStyle="bold"
            android:textColor="#39235E"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtTituloNota"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_campo"
            android:hint="¿Qué tienes en mente?"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="16dp"
            android:textColor="#39235E"
            android:textColorHint="#988AA8" />

        <!-- Contenido de la nota -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tus pensamientos"
            android:textStyle="bold"
            android:textColor="#39235E"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtContenidoNota"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_campo"
            android:hint="Escribe aquí lo que quieras recordar..."
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:padding="16dp"
            android:textColor="#39235E"
            android:textColorHint="#988AA8" />

        <!-- Emoción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="¿Cómo te sientes?"
            android:textStyle="bold"
            android:textColor="#39235E"
            android:textSize="15sp" />


        <GridLayout
            android:id="@+id/gridEmociones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false" />


        <!-- Guardar -->
        <Button
            android:id="@+id/btnGuardarNota"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Guardar nota"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7548C4" />

    </LinearLayout>

</ScrollView>
