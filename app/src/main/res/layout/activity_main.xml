<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEFF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- LIBRETA ANIMADA ORIGINAL -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/fondoBienvenida"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/fondo_circular" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/imgBienvenida"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:contentDescription="Libreta animada de bienvenida"
                    app:lottie_rawRes="@raw/animacion_bienvenida"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

            </FrameLayout>

            <!-- LOGO -->
            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="✦ NOTIVA ✦"
                android:textColor="#7548C4"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- BIENVENIDA -->
            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="¡Bienvenido a NOTIVA!"
                android:textColor="#39235E"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Un espacio para guardar tus ideas, expresar tus emociones y recordar cada momento importante."
                android:textColor="#655477"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <!-- FUNCIONALIDADES DE NOTIVA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- CREAR Y EDITAR -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/fondo_tarjeta_bienvenida">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_funcion_editar"
                        android:contentDescription="Crear y editar notas" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Crea y edita"
                        android:textColor="#39235E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- EMOCIONES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/fondo_tarjeta_bienvenida">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_funcion_emocion"
                        android:contentDescription="Expresar emociones" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Expresa emociones"
                        android:textColor="#39235E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- BUSCAR -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/fondo_tarjeta_bienvenida">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_funcion_buscar"
                        android:contentDescription="Buscar y organizar notas" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Busca y organiza"
                        android:textColor="#39235E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- BOTÓN PRINCIPAL -->
            <Button
                android:id="@+id/btnComenzar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="Comenzar mi aventura"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7548C4" />

            <TextView
                android:id="@+id/txtFrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Tus pensamientos merecen un lugar especial ♡"
                android:textColor="#827395"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
