<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEFF"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:isScrollContainer="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <ImageButton
            android:id="@+id/btnVolverRegistro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_volver"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="Volver al inicio de sesión" />


        <ImageView
            android:id="@+id/imgRegistro"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_circular"
            android:src="@drawable/ic_registro"
            android:padding="24dp"
            android:contentDescription="Icono de registro" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="¡Comienza tu historia!"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#39235E"
            android:gravity="center" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Crea tu cuenta y dale un hogar a tus ideas."
            android:textSize="15sp"
            android:textColor="#655477"
            android:gravity="center" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Nombre de usuario"
            android:textColor="#39235E"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_campo"
            android:hint="¿Cómo te llamas?"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="16dp"
            android:textColor="#39235E"
            android:textColorHint="#988AA8" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Correo electrónico"
            android:textColor="#39235E"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_campo"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="16dp"
            android:textColor="#39235E"
            android:textColorHint="#988AA8" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contraseña"
            android:textColor="#39235E"
            android:textStyle="bold"
            android:textSize="14sp" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edtPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_campo"
                android:hint="Crea una contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="60dp"
                android:textColor="#39235E"
                android:textColorHint="#988AA8" />

            <ImageButton
                android:id="@+id/btnOjoRegistro"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:src="@drawable/ic_ojo_cerrado"
                android:contentDescription="Mostrar contraseña" />

        </FrameLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Confirmar contraseña"
            android:textColor="#39235E"
            android:textStyle="bold"
            android:textSize="14sp" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edtConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_campo"
                android:hint="Repite tu contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="60dp"
                android:textColor="#39235E"
                android:textColorHint="#988AA8" />

            <ImageButton
                android:id="@+id/btnOjoConfirmar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:src="@drawable/ic_ojo_cerrado"
                android:contentDescription="Mostrar contraseña" />

        </FrameLayout>



        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Crear mi cuenta"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7548C4" />


        <TextView
            android:id="@+id/txtIrLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="#827395"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
