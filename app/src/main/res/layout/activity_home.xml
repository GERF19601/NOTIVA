<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEFF">

    <LinearLayout
        android:id="@+id/contenidoHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✦ NOTIVA ✦"
                android:textColor="#7548C4"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_cerrar_sesion"
                android:background="@drawable/fondo_campo"
                android:contentDescription="Cerrar sesión"
                android:padding="12dp" />

        </LinearLayout>


        <TextView
            android:id="@+id/txtSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¡Hola!"
            android:textColor="#39235E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tus pensamientos, tu espacio."
            android:textColor="#655477"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtBuscarNotas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/fondo_campo"
            android:hint="Buscar en mis notas..."
            android:singleLine="true"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="#39235E"
            android:textColorHint="#988AA8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mis notas"
                android:textColor="#39235E"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCantidadNotas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 notas"
                android:textColor="#7548C4"
                android:textSize="14sp" />
        </LinearLayout>


        <FrameLayout
            android:id="@+id/contenedorNotas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp">

            <!-- Mensaje cuando no existen notas -->
            <LinearLayout
                android:id="@+id/estadoVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/fondo_campo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#7548C4"
                    android:textSize="42sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tu historia comienza aquí"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="#39235E"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aún no tienes notas. Guarda tu primera idea para comenzar."
                    android:textColor="#655477"
                    android:textSize="14sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Listado cuando existen notas -->
            <ScrollView
                android:id="@+id/scrollNotas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="false">

                <LinearLayout
                    android:id="@+id/listaNotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="88dp" />

            </ScrollView>

        </FrameLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnNuevaNota"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7548C4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
