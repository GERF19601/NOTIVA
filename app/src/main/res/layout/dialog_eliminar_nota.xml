<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/fondo_dialogo_eliminar">

    <TextView
        android:id="@+id/txtTituloDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Eliminar esta nota?"
        android:textColor="#39235E"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtMensajeDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Esta acción no se puede deshacer."
        android:textColor="#655477"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnCancelarDialogo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="100dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Cancelar"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#655477"
            android:background="@drawable/fondo_boton_cancelar"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnEliminarDialogo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="100dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Eliminar"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/fondo_boton_eliminar"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
